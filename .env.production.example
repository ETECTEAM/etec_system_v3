# Production environment template.
# Copy to `.env` on the server and fill in every value marked CHANGE_ME.
# Never commit the real .env — it stays server-side only.

APP_NAME="ETEC SYSTEM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME_DOMAIN
APP_PORT=8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================
# DATABASE
# ==============================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=etec_system
DB_USERNAME=etec_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ==============================
# SESSION
# ==============================
# `file` driver is fine here: only one app container serves web requests
# (queue/scheduler don't touch sessions), and storage/ is a persistent
# volume, so sessions survive container restarts. A `sessions` table
# migration doesn't exist in this repo yet, so don't switch to `database`
# without running `php artisan session:table` first.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ==============================
# CACHE & QUEUE
# ==============================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Real queue processing (jobs table already migrated) — the `queue` container
# runs `php artisan queue:work` against this connection. Do not use `sync`
# in production: it blocks the HTTP request for anything queued, e.g. the
# Telegram admin-approval notification.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ==============================
# MAIL
# ==============================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@CHANGE_ME_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================
# AWS (optional — only if offloading uploads to object storage)
# ==============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================
# FRONTEND
# ==============================
VITE_APP_NAME="${APP_NAME}"

DEBUGBAR_ENABLED=false
SCRIBE_ENABLED=false
XDEBUG_MODE=off

# ==============================
# TELEGRAM BOT
# ==============================
# The token that used to live here (in .env.example, committed to git) is
# compromised — rotate it via @BotFather before going live and put the NEW
# token here only. Never commit real values for these three.
OTP_VERIFICATION_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_ROTATED_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME_ADMIN_CHAT_ID
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET
