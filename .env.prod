APP_NAME="ETEC SYSTEM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://etec-center.space
# Keep APP_URL aligned with the browser URL to avoid session/CSRF issues.
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Dummy bcrypt hash checked on login when no user is found, to keep response
# timing consistent and avoid leaking account existence. Cost must match
# BCRYPT_ROUNDS above. Generate per-environment with:
# password_hash('anything', PASSWORD_BCRYPT, ['cost' => 12])
AUTH_DUMMY_PASSWORD_HASH='$2y$12$tHtyWiLhB93IiFOwLuWrnuF2pjUt8EY14lb9rJnnATJGw/gUTBbMC'

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================
# DATABASE
# ==============================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=etec_db
DB_USERNAME=etec_database
DB_PASSWORD=3CxaWMGEcA7p3HTJD0zBAaDstDut6HFdaxOHLCz5FNY=
MYSQL_ROOT_PASSWORD=t8OFMfD5nR3HpUWKrWrTOdNT/BUKfyWZw4MKgjtZEFQ=

# ==============================
# SESSION
# ==============================
# database: lets password-reset invalidate a user's other sessions
# by deleting their rows from the sessions table.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==============================
# CACHE & QUEUE
# ==============================
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# ==============================
# REVERB (real-time dashboard notifications)
# ==============================
# Generate per-environment with `php artisan reverb:install` - do not reuse
# another environment's values.
REVERB_APP_ID=b130c8543d2c65644ff0e8f5e61052e0
REVERB_APP_KEY=8msLmi-XQkIAxfHI3nvllc1m13ve155thOUNLvEoVLc
REVERB_APP_SECRET=1a778c3a45648c5be68d040ce28faa2633629e66f8fb1eaf35f728863adbb3ea
REVERB_HOST="etec-center.space"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==============================
# REDIS (optional, local)
# ==============================
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================
# MAIL (Mailtrap sandbox - dev)
# ==============================
# Fill MAIL_USERNAME/MAIL_PASSWORD from your Mailtrap inbox's SMTP settings
# (Mailtrap > Email Testing > Inboxes > <inbox> > SMTP Settings).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=eteccentersystem@gmail.com
MAIL_PASSWORD=dqmtnzymgpeqcxkf
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=eteccentersystem@gmail.com
MAIL_FROM_NAME="${APP_NAME}"


# ==============================
# AWS (optional)
# ==============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================
# FRONTEND
# ==============================
VITE_APP_NAME="${APP_NAME}"

DEBUGBAR_ENABLED=
SCRIBE_ENABLED=
XDEBUG_MODE=off

# ==============================
# TELEGRAM BOT
# ==============================
OTP_VERIFICATION_ENABLED=true
# TODO: rotate via @BotFather before going live if this token was ever
# committed to git history / shared outside the team - never reuse a leaked
# token in production.
TELEGRAM_BOT_TOKEN=8978651307:AAHKcgsfs7hN3_bjSm2KZB3Lu1Z3alVA3C0
TELEGRAM_ADMIN_CHAT_ID=-1004478563895

TELEGRAM_ERROR_BOT_TOKEN=8880118557:AAFIX5H991Vdz7_iRdBhOFZUZSFYnla8GMU
TELEGRAM_ERROR_CHAT_ID=-1003977107923
TELEGRAM_PERSONAL_CHAT_ID=

# Required: the webhook now fails closed (401) when this is unset, so the
# approve/reject buttons stop working until it's configured. Must match
# exactly what's registered with Telegram via setWebhook's secret_token param.
TELEGRAM_WEBHOOK_SECRET=011f596b1819741d2a5d0d334f740a8babeb4bc60dbba54c256e2c566d7ebfdc

# ==============================
# PDF RENDERING
# ==============================
# Optional. Absolute path to a Chrome/Chromium binary used by the class-result
# PDF export. Leave blank to auto-detect chromium on PATH (the Docker image
# ships it); set it only for a non-standard install, e.g. /usr/bin/chromium.

CHROME_PATH=
