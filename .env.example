APP_NAME="ETEC SYSTEM"
# Docker development defaults.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
# Keep APP_URL aligned with the browser URL to avoid session/CSRF issues.
APP_PORT=8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Dummy bcrypt hash checked on login when no user is found, to keep response
# timing consistent and avoid leaking account existence. Cost must match
# BCRYPT_ROUNDS above. Generate per-environment with:
# password_hash('anything', PASSWORD_BCRYPT, ['cost' => 12])
AUTH_DUMMY_PASSWORD_HASH='$2y$12$tHtyWiLhB93IiFOwLuWrnuF2pjUt8EY14lb9rJnnATJGw/gUTBbMC'

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================
# DATABASE (Docker development)
# ==============================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=etec_db
DB_USERNAME=laravel_user
DB_PASSWORD=secret123
MYSQL_ROOT_PASSWORD=root123

# ==============================
# SESSION
# ==============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==============================
# CACHE & QUEUE
# ==============================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# ==============================
# REDIS (optional, local)
# ==============================
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================
# MAIL (local)
# ==============================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================
# AWS (optional)
# ==============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================
# FRONTEND
# ==============================
VITE_APP_NAME="${APP_NAME}"

DEBUGBAR_ENABLED=
SCRIBE_ENABLED=
XDEBUG_MODE=off

# ==============================
# TELEGRAM BOT
# ==============================
OTP_VERIFICATION_ENABLED=true
TELEGRAM_BOT_TOKEN=7959018611:AAFA92y8e0iUgMsnc15d9dWAiTbKuiZMlL0
TELEGRAM_ADMIN_CHAT_ID=6960648008
TELEGRAM_WEBHOOK_SECRET=https://pokeapi.co/api/v2/pokemon/charizard
